</Tags>
<Programs>
<Program Name="Safety_Perms" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Description>
<LocalizedDescription Lang="de-DE"><![CDATA[Freigaben]]></LocalizedDescription>
<LocalizedDescription Lang="en-US"><![CDATA[Line permissives]]></LocalizedDescription>
</Description>
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Line may run only with E-stop healthy and upstream ready.]]></Comment>
<Text><![CDATA[XIC(E_Stop_OK)XIC(Upstream_Ready.0)OTE(Line_Permissive);]]></Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Sequencer" TestEdits="false" MainRoutineName="Main" FaultRoutineName="Fault" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="RunCmd" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Step" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="StartPB" TagType="Alias" AliasFor="Local:1:I.Data.1" Radix="Decimal" ExternalAccess="Read Only"/>
</Tags>
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[JSR(Seq_ST,0);]]></Text>
</Rung>
<Rung Number="1" Type="rr">
<Text><![CDATA[JSR(Seq_SFC,0);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Seq_ST" Type="ST">
<Description><![CDATA[Conveyor run sequence]]></Description>
<STContent>
<Line Number="0"><![CDATA[CASE Step OF]]></Line>
<Line Number="1"><![CDATA[    0:  RunCmd := 0;]]></Line>
<Line Number="2"><![CDATA[        IF StartPB AND Line_Permissive THEN Step := 10; END_IF;]]></Line>
<Line Number="3"><![CDATA[    10: RunCmd := 1;]]></Line>
<Line Number="4"><![CDATA[        IF NOT Line_Permissive THEN Step := 0; END_IF;]]></Line>
<Line Number="5"><![CDATA[END_CASE;]]></Line>
</STContent>
</Routine>
<Routine Name="Seq_SFC" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step_" TransitionName="Tran_" ActionName="Action_" StopName="Stop_">
<Step ID="0" X="200" Y="100" Operand="Step_000" HideDesc="false" DescX="300" DescY="100" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true"/>
<Transition ID="1" X="200" Y="200" Operand="Tran_000" HideDesc="false" DescX="300" DescY="200" DescWidth="0">
<Condition>
<STContent>
<Line Number="0"><![CDATA[StartPB]]></Line>
</STContent>
</Condition>
</Transition>
<Step ID="2" X="200" Y="300" Operand="Step_001" HideDesc="false" DescX="300" DescY="300" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false" LimitLowUsesExpr="false" ShowActions="true"/>
<DirectedLink FromID="0" ToID="1" Show="true"/>
<DirectedLink FromID="1" ToID="2" Show="true"/>
</SFCContent>
</Routine>
<Routine Name="Fault" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[MOV(0,Step);]]></Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Outputs" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="RunReq" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Conv_Ctl" TagType="Base" DataType="MotorCtl" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Speed_Ref" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Speed_Out" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Motor control AOI drives Conv_Motor.Cmd through its InOut parameter.]]></Comment>
<Text><![CDATA[XIC(RunReq)XIC(Line_Permissive)MotorCtl(Conv_Ctl,RunReq,Conv_Motor);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Energise the contactor.]]></Comment>
<Text><![CDATA[XIC(Conv_Motor.Cmd)[XIC(Line_Permissive),XIC(Faults[0,1].5)]OTE(Conveyor_Run_Out);]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Text><![CDATA[JSR(Speed,0);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Speed" Type="FBD">
<FBDContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape">
<Sheet Number="1">
<IRef ID="0" X="100" Y="100" Operand="Speed_Ref" HideDesc="false"/>
<ORef ID="1" X="400" Y="100" Operand="Speed_Out" HideDesc="false"/>
<Wire FromID="0" ToID="1"/>
</Sheet>
</FBDContent>
</Routine>
<EncodedData EncodedType="Routine" Name="Vendor_Tuning" Type="RLL" EncryptionConfig="3"><![CDATA[cHJvdGVjdGVk]]></EncodedData>
</Routines>
</Program>

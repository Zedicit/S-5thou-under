<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="MotorCtl" Revision="2.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2024-01-01T00:00:00.000Z" CreatedBy="demo" EditedDate="2024-01-01T00:00:00.000Z" EditedBy="demo" SoftwareRevision="v32.02">
<Description><![CDATA[Start/stop motor with start delay]]></Description>
<RevisionNote><![CDATA[Demo]]></RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Run" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description><![CDATA[Request to run]]></Description>
<DefaultData Format="L5K"><![CDATA[0]]></DefaultData>
</Parameter>
<Parameter Name="Motor" TagType="Base" DataType="Motor_UDT" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Delay" DataType="TIMER" ExternalAccess="None">
<DefaultData Format="L5K"><![CDATA[[0,5000,0]]]></DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[XIC(Run)TON(Delay,?,?);]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Text><![CDATA[XIC(Delay.DN)OTE(Motor.Cmd);]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="EnableInFalse" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text><![CDATA[OTU(Motor.Cmd);]]></Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
